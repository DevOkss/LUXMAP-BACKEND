# LuxMap (SOMS) — production environment template
# Copy to .env on the VPS, fill in every <...> placeholder, then run:
#   php artisan key:generate
#
# Secrets cheat-sheet:
#   QR_ENCRYPTION_KEY : openssl rand -hex 32
#   VAPID keys        : php artisan webpush:vapid  (or generate via
#                       https://tools.reactpwa.com/vapid) — subject must be a mailto:

APP_NAME=LuxMap
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://luxmap.devokss.online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soms
DB_USERNAME=soms_user
DB_PASSWORD=<MYSQL_PASSWORD>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Student PWA origin (drives the /app landing page "Open App" button).
PWA_URL=https://<YOUR-PWA>.vercel.app

# Comma-separated list of origins allowed to call this API cross-origin.
# Must include the deployed student PWA origin exactly (scheme + host, no slash).
CORS_ALLOWED_ORIGINS=https://<YOUR-PWA>.vercel.app

# Web Push (VAPID). Generate once:
#   php artisan webpush:vapid
# GOTCHAS (2026-09-05 prod 500): keys are base64url (may contain -/_ and no
# padding) — do NOT paste standard-base64 or re-wrap lines. Never leave a
# duplicate empty VAPID_PRIVATE_KEY= line lower in the file (last one wins and
# silently blanks the key). Any .env change REQUIRES `php artisan config:cache`
# afterwards — the cached config shadows .env. VAPID_PUBLIC_KEY must match the
# PWA's baked key (pwa-soms src/config/app.ts PROD_VAPID_KEY / Vercel
# VITE_VAPID_PUBLIC_KEY).
VAPID_SUBJECT=mailto:admin@devokss.online
VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<VAPID_PRIVATE_KEY>

# AES-256-CBC key for QR payloads (64 hex chars). REQUIRED — without it QR
# generation falls back to APP_KEY and produces invalid keys.
#   openssl rand -hex 32
QR_ENCRYPTION_KEY=<QR_ENCRYPTION_KEY>

# PayMongo (abandoned feature) — leave empty; inert unless keys are set.
PAYMONGO_API_URL=https://api.paymongo.com/v2
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_SUCCESS_URL=
PAYMONGO_CANCEL_URL=

# Mock institution API (leave empty in production unless you have one).
INSTITUTION_API_URL=
